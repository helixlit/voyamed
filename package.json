{
  "name": "@voyamed",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "sh scripts/dev.sh",
    "fresh-dev": "sh scripts/fresh-dev.sh",
    "builddev": "sh scripts/build-dev.sh",
    "studio": "sh scripts/studio.sh",
    "restart-catalog-database": "sh scripts/restart-catalog-database.sh",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm turbo run build --filter @prisma/example-store... && ( set -a; . ../../.env; set +a; bun node_modules/.bin/prisma-composer deploy module.ts ${STORE_STACK_NAME:+--name \"$STORE_STACK_NAME\"} )",
    "destroy": "( set -a; . ../../.env; set +a; bun node_modules/.bin/prisma-composer destroy module.ts --production ${STORE_STACK_NAME:+--name \"$STORE_STACK_NAME\"} )",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@prisma/client": "^7.10.0",
    "@prisma/composer-cli": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@voyamed/catalog": "workspace:*",
    "@voyamed/storefront": "workspace:*",
    "alchemy": "2.0.0-beta.77",
    "arktype": "^2.2.3",
    "dotenv": "^17.4.2",
    "effect": "4.0.0-rc.112",
    "mollie-api-typescript": "^1.12.33",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/cli-engine": "0.2.3",
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.10.0",
    "prisma": "8.0.0-rc.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "effect": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
