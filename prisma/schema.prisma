generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  pzn          String        @id
  name         String
  active       Boolean
  supplier     String
  unit         String
  purchaseUnit Int
  price        Decimal
  //attributes   ArticleAttribute[]
  shopArticles ShopArticle[]
}

model ShopArticle {
  id         Int     @id @default(autoincrement())
  articlePZN String
  article    Article @relation(fields: [articlePZN], references: [pzn])
}

