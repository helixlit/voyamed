generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  pzn          String               @id
  name         String
  active       Boolean
  supplier     String
  unit         String
  purchaseUnit Int
  price        Decimal
  prescription Boolean?
  attributes   ArticleAttributes[]?

  shopArticles ShopArticle[]
}

model ShopArticle {
  id         Int    @id @default(autoincrement())
  articlePZN String

  article Article @relation(fields: [articlePZN], references: [pzn])
}

model ArticleAttributes {
  id    Int    @id @default(autoincrement())
  name  String
  value String

  articlePZN String  @unique
  articles   Article @relation(fields: [articlePZN], references: [pzn])
}
