# Copy to `.env` and fill in the values. Never commit the real `.env`.

# Antonius-Apotheke catalog API
BASE_URL=
USERNAME=
PASSWORD=

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe — Dashboard → Developers → Webhooks
#   Endpoint: https://<shop-domain>/api/stripe/webhook
#   Events:   checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Resend — order emails to the pharmacy and confirmations to customers
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Voyamed <bestellung@voyamed.de>".
# (Resend's shared onboarding@resend.dev can only send to your own Resend account address.)
ORDER_NOTIFICATION_FROM=
# Pharmacy inbox for new orders; customers' replies to their confirmation go here too.
# Test inbox until launch — switch to the pharmacy's address before going live.
ORDER_NOTIFICATION_EMAIL=voyamed.test@gmail.com

# Optional: set to `true` in production to turn off the bundled read-only catalog
# that is shown when the pharmacy catalog is unreachable.
# VOYAMED_DISABLE_LOCAL_CATALOG_FALLBACK=true
